# Biomarker Trend Analyzer — environment
# Copy to .env and adjust. Never commit real .env files.

# Store: memory (demo, no infra) or postgres (migrations run at startup)
APP_STORE=memory
# APP_DATABASE_URL=postgresql://app:app@localhost:5433/biomarkers

# Synthetic demo data seeding (3 patients, 576 readings, injected anomalies)
APP_SEED_DEMO=true
APP_DEMO_CSV=crates/api/tests/fixtures/demo_labs.csv

# Personal-baseline lookback window (days)
APP_WINDOW_DAYS=90

# Port (8000/8001 taken by ZAP_AGI / drug-interaction-visualizer)
APP_PORT=8003
