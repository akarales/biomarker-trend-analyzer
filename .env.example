# Biomarker Trend Analyzer — environment
# Copy to .env and adjust. Never commit real .env files.

# Store: memory (demo, no infra) or postgres (migrations run at startup)
APP_STORE=memory
# APP_DATABASE_URL=postgresql://app:app@127.0.0.1:5435/biomarkers

# Synthetic demo data (demo/: Synthea subset + edge cases, see demo/PROVENANCE.md)
APP_SEED_DEMO=true
APP_DEMO_DATA=demo

# Trend lookback window in days (default; per request: ?window_days=)
APP_WINDOW_DAYS=1095

# Port (8000/8001 taken by ZAP_AGI / drug-interaction-visualizer)
APP_PORT=8003

# "Explain this drift" (LLM). Stub = deterministic offline text, no model call.
APP_LLM_STUB=true
# used when APP_LLM_STUB=false (the chooser can still pick any available model)
APP_LLM_PROVIDER=ollama
APP_OLLAMA_URL=http://localhost:11434
APP_OLLAMA_MODEL=qwen3:14b
# the Ollama instance is SHARED: short keep-alive, never pull/delete models
APP_OLLAMA_KEEP_ALIVE=2m
APP_ANTHROPIC_MODEL=claude-sonnet-5-5
# ANTHROPIC_API_KEY=   (secret — only in your local, gitignored .env)
